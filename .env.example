# ----------------------------------------------------------------------------
# InfraMonitor AI - variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# ----------------------------------------------------------------------------

# Banco de dados (Postgres local via Docker - compatível com schema Supabase)
POSTGRES_USER=inframonitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=inframonitor

# Backend
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
SNMP_ENCRYPTION_KEY=troque-por-32-caracteres-no-minimo!!
MONITOR_TICK_SECONDS=15
CORS_ORIGIN=http://localhost:5173

# Login social (opcional — deixe em branco para manter apenas login por e-mail/senha)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Insights de tráfego com IA (opcional — sem chave, o sistema usa heurísticas locais)
ANTHROPIC_API_KEY=

# Agente Windows/Linux (proxy de monitoramento) — mesmo token deve ser configurado
# no agent-config.json do agente. Deixe em branco para desabilitar os endpoints do agente.
AGENT_TOKEN=

# Notificações (opcionais - deixe em branco para desabilitar o canal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (URL pública da API, usada no build da imagem)
VITE_API_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# Supabase Cloud
# Projeto já provisionado: https://dtvdpmygatotpyfeothu.supabase.co (ref
# dtvdpmygatotpyfeothu, região ca-central-1) com o schema já aplicado.
#
# IMPORTANTE: não use a "Direct connection" (db.<ref>.supabase.co:5432) a
# partir do Docker Desktop/rede doméstica — ela só funciona por IPv6 e a
# maioria das redes locais não tem IPv6, então a conexão nunca fecha e o
# backend fica preso em "aguardando banco de dados".
#
# Use o "Session pooler" (sempre IPv4). No painel do Supabase, clique em
# "Connect" no topo do projeto → aba "Session pooler" → copie a URI exibida
# lá (o host/usuário exatos variam por projeto, por isso é melhor copiar
# direto do painel em vez de digitar de memória) e troque [YOUR-PASSWORD]
# pela senha do banco:
#
# DATABASE_URL=postgres://postgres.dtvdpmygatotpyfeothu:SUA_SENHA_AQUI@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
#
# Depois suba com: docker compose -f docker-compose.supabase.yml up --build
# Ver README.md, seção "Usando o Supabase Cloud", para o passo a passo completo.
# ----------------------------------------------------------------------------
